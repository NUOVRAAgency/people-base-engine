# ─────────────────────────────────────────────────────────────
# اتصال Supabase (قيم عامة بطبيعتها — الحماية الفعلية عبر RLS)
# انسخ هذا الملف إلى .env وبدّل القيم عند نشر المشروع لعميل جديد.
# لا حاجة لتعديل أي سطر في الشفرة المصدرية.
# ─────────────────────────────────────────────────────────────

# تُستخدم في المتصفح (Vite)
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<publishable-or-anon-key>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# تُستخدم على الخادم (SSR / server functions)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<publishable-or-anon-key>"
SUPABASE_PROJECT_ID="<project-ref>"

# ─────────────────────────────────────────────────────────────
# أسرار الخادم — لا تُوضع هنا ولا في أي ملف .env للواجهة الأمامية:
#   GEMINI_API_KEY        → تُحفظ حصراً في أسرار الخلفية (Edge Function Secrets)
#   SUPABASE_SERVICE_ROLE_KEY → تُدار من الخلفية فقط
# أي متغير يبدأ بـ VITE_ يصل إلى المتصفح، لذلك لا يجوز وضع أي مفتاح سري فيه.
# ─────────────────────────────────────────────────────────────
